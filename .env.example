# TUKUBI Environment Variables — copy to .env.local and fill in your values
# Never commit actual secrets to the repository.

# ============================================================
# Supabase (Required)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# AI — OpenRouter (Required for AI features)
# https://openrouter.ai/keys
# ============================================================
OPENROUTER_API_KEY=

# ============================================================
# Cloudflare Stream — Live Streaming CDN
# Setup: dash.cloudflare.com → Stream → API Tokens
# Create a token with Stream:Edit permission on your account.
# ============================================================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# ============================================================
# Payments (see PAYMENT-ARCHITECTURE.md for full setup)
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
