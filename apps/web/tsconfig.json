{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@caribbean/search": ["../../packages/search/src"],
      "@caribbean/recommendations": ["../../packages/recommendations/src"],
      "@caribbean/social": ["../../packages/social/src"],
      "@caribbean/database": ["../../packages/database/src"],
      "@caribbean/localization": ["../../packages/localization/src"],
      "@caribbean/ai": ["../../packages/ai/src"],
      "@caribbean/design-system": ["../../packages/design-system/src"],
      "@caribbean/ui": ["../../packages/ui/src"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
