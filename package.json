{
  "name": "tukubi",
  "version": "1.0.0",
  "private": true,
  "description": "TUKUBI — The Caribbean Connected. Global Diaspora & Digital Platform",
  "author": "Tukubi Engineering",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check:prohibited": "node scripts/ci/check-prohibited-references.js",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,sql}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
