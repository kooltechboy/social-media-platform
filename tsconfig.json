{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@caribbean/ui": ["./packages/ui/src"],
      "@caribbean/design-system": ["./packages/design-system/src"],
      "@caribbean/database": ["./packages/database/src"],
      "@caribbean/auth": ["./packages/auth/src"],
      "@caribbean/api": ["./packages/api/src"],
      "@caribbean/spotpay": ["./packages/spotpay/src"],
      "@caribbean/ai": ["./packages/ai/src"],
      "@caribbean/trust-safety": ["./packages/trust-safety/src"],
      "@caribbean/localization": ["./packages/localization/src"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
