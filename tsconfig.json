{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@caribbean/ui": ["./packages/ui/src"],
      "@caribbean/design-system": ["./packages/design-system/src"],
      "@caribbean/database": ["./packages/database/src"],
      "@caribbean/auth": ["./packages/auth/src"],
      "@caribbean/api": ["./packages/api/src"],
      "@caribbean/payments": ["./packages/payments/src"],
      "@caribbean/spotpay": ["./packages/payments/src"],
      "@caribbean/ai": ["./packages/ai/src"],
      "@caribbean/trust-safety": ["./packages/trust-safety/src"],
      "@caribbean/localization": ["./packages/localization/src"],
      "@caribbean/social": ["./packages/social/src"],
      "@caribbean/media": ["./packages/media/src"],
      "@caribbean/messaging": ["./packages/messaging/src"],
      "@caribbean/notifications": ["./packages/notifications/src"],
      "@caribbean/analytics": ["./packages/analytics/src"],
      "@caribbean/search": ["./packages/search/src"],
      "@caribbean/communities": ["./packages/communities/src"],
      "@caribbean/creator": ["./packages/creator/src"],
      "@caribbean/live": ["./packages/live/src"],
      "@caribbean/podcasts": ["./packages/podcasts/src"],
      "@caribbean/recommendations": ["./packages/recommendations/src"],
      "@caribbean/advertising": ["./packages/advertising/src"],
      "@caribbean/business": ["./packages/business/src"],
      "@caribbean/marketplace": ["./packages/marketplace/src"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
